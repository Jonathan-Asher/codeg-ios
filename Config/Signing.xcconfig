// Shared signing defaults. The Apple Developer Team ID is not a secret, so the
// fork's team is committed here; certificates, profiles and API keys are not.
CODEG_DEVELOPMENT_TEAM = 3L92BZK46V

// Optional developer-local override (ignored by Git), e.g. to build with a
// different team.
#include? "Signing.local.xcconfig"

DEVELOPMENT_TEAM = $(CODEG_DEVELOPMENT_TEAM)
